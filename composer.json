{
    "name": "vois/vois-php",
    "description": "VOIS SMS ve Ses API istemcisi (PHP 8.1+, Laravel desteği)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "vois",
        "sms",
        "otp",
        "click-to-call",
        "pbx",
        "webhook",
        "laravel"
    ],
    "homepage": "https://docs.vois.com.tr/",
    "support": {
        "email": "destek@vois.com.tr",
        "docs": "https://docs.vois.com.tr/",
        "source": "https://github.com/voistelekom/vois-php",
        "issues": "https://github.com/voistelekom/vois-php/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Vois\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vois\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vois\\Laravel\\VoisServiceProvider"
            ],
            "aliases": {
                "VoisSms": "Vois\\Laravel\\Facades\\VoisSms",
                "VoisVoice": "Vois\\Laravel\\Facades\\VoisVoice",
                "VoisWebhooks": "Vois\\Laravel\\Facades\\VoisWebhooks"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
